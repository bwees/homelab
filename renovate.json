{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>home-operations/renovate-presets"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "semanticCommitType": "chore"
    },
    // External-DNS maintainers seem to love https://0ver.org/ and enjoy
    // releasing large breaking changes in a minor release. This shit is
    // required to keep their updates from taking everything down.
    {
      "matchPackageNames": [
        "ghcr.io/home-operations/charts-mirror/external-dns"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },

    // Wolf only publishes a moving `stable` tag, so updates arrive as digests.
    {
      "matchPackageNames": ["ghcr.io/games-on-whales/wolf"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },

    // Bumping a Wolf app image restarts Wolf and drops every stream, so only
    // merge overnight (UTC hours).
    {
      "matchPackageNames": ["/^ghcr\\.io/bwees/eglantine-/"],
      "automerge": true,
      "schedule": ["* 8-11 * * *"],
      "automergeSchedule": ["* 8-11 * * *"]
    },

    // Groups
    {
      "matchFileNames": ["**/flux-system/**"],
      "groupName": "fluxcd"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Eglantine nightly images in the Wolf app config",
      "managerFilePatterns": ["/kubernetes/apps/hail-mary/gaming/wolf/app/config\\.toml$/"],
      "matchStrings": [
        "image = '(?<depName>ghcr\\.io/bwees/eglantine-[a-z]+):(?<currentValue>daily-\\d{8})@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^daily-(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$"
    }
  ],
  "ignoreTests": true
}
